# Bhajan Studio: settings for docker compose. Copy this file to .env and edit it:
#
#   cp .env.example .env
#
# .env is read by docker compose and is ignored by git. Never commit it.
# Do not put quotes around the values. A "$" in a value must be written "$$".

# ---------------------------------------------------------------------------------------------
# REQUIRED. The password for the whole site. Visitors get a sign-in page and stay signed in for 30
# days on that device; scripts can send it as HTTP Basic auth (any user name). Docker Compose
# refuses to start without it.
# Make a strong one:   openssl rand -base64 24
BHAJAN_PASSWORD=

# ---------------------------------------------------------------------------------------------
# Host names the server answers to, separated by commas. Anything else is refused. 127.0.0.1 and
# localhost always work. Leave it empty to accept any name (fine on a home network, not on a
# public server). With a domain and HTTPS, put the domain here, for example:
#   BHAJAN_ALLOWED_HOSTS=bhajan.example.com
# To also reach the app by the server's address (http://203.0.113.7:8777), list that too:
#   BHAJAN_ALLOWED_HOSTS=bhajan.example.com,203.0.113.7
BHAJAN_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------------------------
# HTTPS through Caddy (only used with:  docker compose --profile https up -d)
#
# Your domain. Its DNS A record (and AAAA, if the server has IPv6) must point at this server,
# and ports 80 and 443 must be open. Caddy gets the certificate by itself.
DOMAIN=

# Which address the app's own port (8777) listens on. 0.0.0.0 = every network interface, so
# anyone can reach http://SERVER:8777. With the https profile, set 127.0.0.1 so that only
# Caddy (and you, on the server) can reach the app and all other traffic goes through HTTPS.
BHAJAN_BIND=0.0.0.0

# The port on the server that the app is published on (inside the container it is always 8777).
BHAJAN_PORT=8777

# ---------------------------------------------------------------------------------------------
# Optional
#
# Seconds between requests to sairhythms.org. Their robots.txt asks for 10. Don't lower it.
# The cost: the first time a song is opened it takes a while. Everything is cached afterwards.
BHAJAN_SITE_GAP=10

# How to read the printed note names on the sheet music: auto, tesseract or none.
# (vision is macOS only.) In the container, auto means tesseract.
BHAJAN_OCR=auto

# 1 = include Parts (splitting a recording into singing, tabla and harmonium).
# 0 = leave it out: a much smaller image. Applies when the image is built (docker compose build).
WITH_PARTS=1

# Always start Caddy too, so that plain "docker compose up -d --build" also works with the https
# profile. Uncomment it once you have set DOMAIN.
#COMPOSE_PROFILES=https

# Only for the NVIDIA GPU build (docker-compose.gpu.yml): which PyTorch build to use. The default
# is CUDA 13.0 (driver 580 or newer). For an older driver or GPU, use CUDA 12.6 (driver 525 or newer):
#TORCH_INDEX=https://download.pytorch.org/whl/cu126
